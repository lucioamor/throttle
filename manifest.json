{
  "manifest_version": 3,
  "minimum_chrome_version": "110",
  "name": "Throttle",
  "version": "2.0.0",
  "description": "Pace control for AI limits. Real-time quota intelligence for Claude and Lovable.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "webRequest"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["intercept.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": ["content-lovable.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor-lovable.js"],
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Throttle - Pace control for AI limits",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
